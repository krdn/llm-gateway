{
  "name": "@krdn/llm-gateway",
  "version": "5.1.0",
  "description": "Multi-provider LLM gateway — unified interface for Anthropic, OpenAI, Gemini, DeepSeek, Ollama, and more. Structured output with JSON repair, retry with backoff, token normalization.",
  "type": "module",
  "license": "MIT",
  "author": "krdn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krdn/llm-gateway.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gateway": {
      "types": "./dist/gateway/index.d.ts",
      "import": "./dist/gateway/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./runner": {
      "types": "./dist/runner/index.d.ts",
      "import": "./dist/runner/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm build && pnpm test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.36",
    "@ai-sdk/google": "^4.0.39",
    "@ai-sdk/openai": "^4.0.36",
    "ai": "^7.0.58",
    "zod-to-json-schema": "^3.25.2"
  },
  "peerDependencies": {
    "ai-sdk-provider-gemini-cli": "^2.0.1",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "llm",
    "ai",
    "gateway",
    "multi-provider",
    "claude",
    "openai",
    "gemini",
    "deepseek",
    "ollama",
    "vercel-ai-sdk",
    "structured-output",
    "json-repair"
  ],
  "sideEffects": false,
  "packageManager": "pnpm@10.28.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependenciesMeta": {
    "ai-sdk-provider-gemini-cli": {
      "optional": true
    }
  }
}
