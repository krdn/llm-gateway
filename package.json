{
  "name": "@krdn/ai-analysis-kit",
  "version": "1.0.0",
  "description": "Reusable AI analysis modules (12 modules) for political opinion analysis pipelines — extracted from ai-signalcraft.",
  "type": "module",
  "license": "MIT",
  "author": "krdn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krdn/ai-analysis-kit.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./modules": {
      "types": "./dist/modules/index.d.ts",
      "import": "./dist/modules/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas/index.d.ts",
      "import": "./dist/schemas/index.js"
    },
    "./gateway": {
      "types": "./dist/gateway/index.d.ts",
      "import": "./dist/gateway/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./runner": {
      "types": "./dist/runner/index.d.ts",
      "import": "./dist/runner/index.js"
    }
  },
  "bin": {
    "ai-analysis": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "build:tsc": "tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "eval": "node dist/cli/index.js eval",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "latest",
    "@ai-sdk/google": "latest",
    "@ai-sdk/openai": "latest",
    "ai": "^6.0.0",
    "ai-sdk-provider-gemini-cli": "^2.0.1",
    "cac": "^6.7.14",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "peerDependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ai",
    "llm",
    "analysis",
    "political-opinion",
    "claude",
    "gemini",
    "vercel-ai-sdk"
  ]
}
