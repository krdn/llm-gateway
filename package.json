{
  "name": "@krdn/llm-gateway",
  "version": "3.3.0",
  "description": "Multi-provider LLM gateway — unified interface for Anthropic, OpenAI, Gemini, DeepSeek, Ollama, and more. Structured output with JSON repair, retry with backoff, token normalization.",
  "type": "module",
  "license": "MIT",
  "author": "krdn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/krdn/llm-gateway.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./gateway": {
      "types": "./dist/gateway/index.d.ts",
      "import": "./dist/gateway/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./runner": {
      "types": "./dist/runner/index.d.ts",
      "import": "./dist/runner/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.67",
    "@ai-sdk/google": "^3.0.59",
    "@ai-sdk/openai": "^3.0.51",
    "ai": "^6.0.149",
    "ai-sdk-provider-gemini-cli": "^2.0.1",
    "zod": "^3.24.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "peerDependencies": {
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "llm",
    "ai",
    "gateway",
    "multi-provider",
    "claude",
    "openai",
    "gemini",
    "deepseek",
    "ollama",
    "vercel-ai-sdk",
    "structured-output",
    "json-repair"
  ]
}
